# Cache headers for /assets/* are set in functions/assets/[[path]].js, not
# here: a rule here would also stamp "immutable" on the index.html fallback
# Pages serves for a missing asset, and that poisoned caches (white page).
# HTML must never be cached, so every visit picks up the current asset names.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate
